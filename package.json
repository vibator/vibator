{
  "name": "vibator",
  "version": "3.0.0",
  "description": "Project rules instead of check scripts: a small framework for the checks your linters do not cover.",
  "type": "module",
  "license": "MIT",
  "author": "Josep Boix Requesens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibator/vibator.git"
  },
  "bugs": {
    "url": "https://github.com/vibator/vibator/issues"
  },
  "homepage": "https://github.com/vibator/vibator#readme",
  "keywords": [
    "lint",
    "rules",
    "checks",
    "typescript",
    "javascript",
    "guardrails",
    "coding-agents",
    "ai"
  ],
  "bin": {
    "vibator": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing/index.js",
    "./schema.json": "./schema.json",
    "./docs/*": "./docs/*",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "schema.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "build": "tsc -p tsconfig.build.json && npm run generate",
    "docs:check": "remark . --quiet --frail",
    "docs:format": "remark . --quiet --output",
    "format": "biome format --write",
    "generate": "node scripts/generate-schema.ts",
    "knip": "knip",
    "lint": "biome check",
    "package": "publint && attw --pack . --format table-flipped --no-emoji",
    "prepack": "npm run build",
    "prepare": "husky",
    "self": "node dist/cli.js",
    "test": "vitest run --coverage",
    "verify": "npm run lint && npm run docs:check && npm run arch && npm run knip && npm run build && npm run package && npm run self && npm run test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=5.4 <7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "@types/sarif": "^2.1.7",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.1",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "publint": "^0.3.25",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
